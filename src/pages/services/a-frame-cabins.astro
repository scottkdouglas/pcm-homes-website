---
import BaseLayout from '../../layouts/BaseLayout.astro';

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "A-Frame Cabin Construction",
  "description": "Custom A-frame cabin builder in Ontario. Year-round and seasonal A-frame homes in Muskoka, Kawartha Lakes, and cottage country. Founded in 2015.",
  "serviceType": "Custom Home Construction",
  "provider": { "@id": "https://pcm.homes/#business" },
  "areaServed": [
  { "@type": "AdministrativeArea", "name": "Durham Region" },
  { "@type": "AdministrativeArea", "name": "York Region" },
  { "@type": "AdministrativeArea", "name": "Greater Toronto Area" },
  { "@type": "AdministrativeArea", "name": "Kawartha Lakes" },
  { "@type": "AdministrativeArea", "name": "Muskoka" }
]
};
---

<BaseLayout breadcrumbs={[{ name: "Services", path: "/services" }, { name: "A-Frame Cabins", path: "/services/a-frame-cabins" }]} title="A-Frame Cabin Builder Ontario | Custom A-Frame Homes & Cottages" description="A-frame cabin construction in Ontario from $220-$300/sq ft (construction cost, kit separate). Cabins in Muskoka, Kawartha Lakes and Durham.">
  <!-- Hero Section -->
  <section data-hero="dark" class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/image00011.webp"
        srcset="/images/projects/image00011-800.webp 800w, /images/projects/image00011.webp 1920w"
        sizes="100vw"
        alt="Custom A-frame cabin built by PCM Homes in Ontario cottage country"
        class="w-full h-full object-cover"
        width="1920"
        height="1440"
        fetchpriority="high" decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center text-white pt-24">
      <p class="section-label text-white/80 mb-4">Custom Builds</p>
      <h1 class="text-5xl md:text-7xl font-display font-medium mb-6">
        A-Frame Cabin <span class="italic">Builder</span>
      </h1>
      <p class="text-xl text-white/80 max-w-2xl mx-auto mb-10">
        Custom A-frame cabins and year-round homes across Ontario. 20-40% less than traditional builds. Construction from $220/sq ft.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">
          <span>Discuss Your A-Frame Build</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Snippet Target: What is an A-Frame -->
  <section class="py-24 md:py-32 bg-[var(--color-cream)]">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
        What is an A-Frame Cabin?
      </h2>

      <!-- Featured Snippet Box -->
      <div class="bg-white border-l-4 border-[var(--color-timber)] p-6 md:p-8 mb-10">
        <p class="text-lg md:text-xl text-[var(--color-charcoal)] leading-relaxed">
          <strong>An A-frame cabin is a triangular building where the roof extends from the foundation to the peak on both sides, forming the shape of the letter "A."</strong> There are no traditional exterior walls—the roof IS the wall. A-frame construction costs run $220-$300 per square foot in Ontario (excluding the kit package), typically 20-40% less than conventional homes of similar size.
        </p>
      </div>

      <div class="prose-pcm text-lg">
        <p class="mb-6">
          A-frames became popular in Ontario cottage country in the 1950s and 60s. They work particularly well on sloped or uneven lots—common around Muskoka and Kawartha lakes. The simple foundation requirements and efficient design make them more affordable than traditional builds.
        </p>
        <p class="mb-6">
          The steep 60-degree roof pitch handles Ontario winters naturally. Snow slides off rather than accumulating. No raking, no worrying about snow load crushing your roof. Metal roofing makes this even more effective.
        </p>
        <p>
          We've built A-frames as weekend getaways and full-time family homes. With proper insulation (we build to R-40+), modern HVAC, and triple-pane windows, an A-frame can be just as comfortable year-round as any custom home. The key is building it right from the start—retrofit insulation never works as well.
        </p>
      </div>
    </div>
  </section>

  <!-- Cost Section with Real Numbers -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
            A-Frame Cabin Costs
          </h2>

          <div class="prose-pcm">
            <p class="text-lg mb-6">
              A-frame construction typically costs <strong>$220 to $300 per square foot</strong> in Ontario—about 20-40% less than conventional homes. This covers the build itself (foundation, framing, finishing); the A-frame kit package is a separate cost. The savings come from simpler framing (30-50% less framing time) and reduced material requirements.
            </p>
            <p class="mb-6">
              Here's what that looks like in real dollars:
            </p>
          </div>

          <div class="space-y-4 mb-8">
            <div class="flex justify-between items-center py-4 border-b border-[var(--color-stone)]/20">
              <span class="text-[var(--color-charcoal)] font-medium">800 sq ft cabin (basic)</span>
              <span class="text-[var(--color-timber)] font-display text-xl">$175K - $200K</span>
            </div>
            <div class="flex justify-between items-center py-4 border-b border-[var(--color-stone)]/20">
              <span class="text-[var(--color-charcoal)] font-medium">800 sq ft cabin (year-round)</span>
              <span class="text-[var(--color-timber)] font-display text-xl">$200K - $240K</span>
            </div>
            <div class="flex justify-between items-center py-4 border-b border-[var(--color-stone)]/20">
              <span class="text-[var(--color-charcoal)] font-medium">1,200 sq ft home</span>
              <span class="text-[var(--color-timber)] font-display text-xl">$265K - $360K</span>
            </div>
            <div class="flex justify-between items-center py-4 border-b border-[var(--color-stone)]/20">
              <span class="text-[var(--color-charcoal)] font-medium">1,500 sq ft home (turnkey)</span>
              <span class="text-[var(--color-timber)] font-display text-xl">$330K - $450K</span>
            </div>
          </div>

          <p class="text-[var(--color-slate)] text-sm">
            * Prices shown are construction costs and do not include the A-frame kit package (kits typically start around $60K+). Total project cost = kit + construction. Prices also vary based on site access, finishes, and serviced vs. unserviced land. We provide fixed-price quotes after seeing your lot.
          </p>
        </div>

        <div>
          <h3 class="font-display text-2xl text-[var(--color-charcoal)] mb-6">What Affects the Price</h3>

          <div class="space-y-6">
            <div class="bg-[var(--color-cream)] p-6">
              <h4 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Site Access</h4>
              <p class="text-[var(--color-slate)]">Remote lots with no road access add $20,000-$50,000+. Materials have to be transported by barge or over temporary roads. Accessible lots are significantly cheaper to build on.</p>
            </div>

            <div class="bg-[var(--color-cream)] p-6">
              <h4 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Foundation Type</h4>
              <p class="text-[var(--color-slate)]">Pier foundations are cheapest ($5,000-$15,000). Crawl spaces run $15,000-$30,000. Full basements (which we'd build with ICF) add $40,000-$80,000 but give you usable space.</p>
            </div>

            <div class="bg-[var(--color-cream)] p-6">
              <h4 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Seasonal vs. Year-Round</h4>
              <p class="text-[var(--color-slate)]">A three-season cabin with basic insulation is 15-25% cheaper than a fully insulated, year-round home. The difference is mostly in insulation, windows, and HVAC.</p>
            </div>

            <div class="bg-[var(--color-cream)] p-6">
              <h4 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Services</h4>
              <p class="text-[var(--color-slate)]">Unserviced lots need well ($8,000-$20,000) and septic ($15,000-$40,000). Utility hookups average $20,000+ depending on distance to power and water.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A-Frame vs Traditional Comparison -->
  <section class="py-24 md:py-32 bg-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          A-Frame vs. Traditional Build
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full bg-white">
          <thead>
            <tr class="border-b-2 border-[var(--color-timber)]">
              <th class="text-left p-4 font-display text-lg text-[var(--color-charcoal)]">Factor</th>
              <th class="text-left p-4 font-display text-lg text-[var(--color-charcoal)]">A-Frame</th>
              <th class="text-left p-4 font-display text-lg text-[var(--color-charcoal)]">Traditional</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-stone)]/20">
            <tr>
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Construction Cost (per sq ft, excl. kit)</td>
              <td class="p-4 text-[var(--color-slate)]">$220 - $300</td>
              <td class="p-4 text-[var(--color-slate)]">$200 - $400+</td>
            </tr>
            <tr class="bg-[var(--color-cream)]/50">
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Construction Time</td>
              <td class="p-4 text-[var(--color-slate)]">3-5 months</td>
              <td class="p-4 text-[var(--color-slate)]">6-12 months</td>
            </tr>
            <tr>
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Snow Load Handling</td>
              <td class="p-4 text-[var(--color-slate)]">Excellent (sheds naturally)</td>
              <td class="p-4 text-[var(--color-slate)]">Good (with proper pitch)</td>
            </tr>
            <tr class="bg-[var(--color-cream)]/50">
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Usable Upper Floor Space</td>
              <td class="p-4 text-[var(--color-slate)]">Limited (sloped walls)</td>
              <td class="p-4 text-[var(--color-slate)]">Full</td>
            </tr>
            <tr>
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Storage Space</td>
              <td class="p-4 text-[var(--color-slate)]">Limited (built-ins help)</td>
              <td class="p-4 text-[var(--color-slate)]">Flexible</td>
            </tr>
            <tr class="bg-[var(--color-cream)]/50">
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Natural Light</td>
              <td class="p-4 text-[var(--color-slate)]">Exceptional (large window walls)</td>
              <td class="p-4 text-[var(--color-slate)]">Standard</td>
            </tr>
            <tr>
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Roof Maintenance</td>
              <td class="p-4 text-[var(--color-slate)]">More challenging (steep pitch)</td>
              <td class="p-4 text-[var(--color-slate)]">Standard</td>
            </tr>
            <tr class="bg-[var(--color-cream)]/50">
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Furniture Layout</td>
              <td class="p-4 text-[var(--color-slate)]">Requires planning (angled walls)</td>
              <td class="p-4 text-[var(--color-slate)]">Standard</td>
            </tr>
            <tr>
              <td class="p-4 font-medium text-[var(--color-charcoal)]">Best For</td>
              <td class="p-4 text-[var(--color-slate)]">Cottages, vacation homes, couples</td>
              <td class="p-4 text-[var(--color-slate)]">Large families, lots of storage</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-[var(--color-slate)] text-center mt-8 max-w-3xl mx-auto">
        A-frames aren't for everyone. If you need lots of storage, multiple bedrooms with full-height ceilings, or standard furniture layouts, a traditional build might make more sense. But if you want dramatic spaces, lower costs, and a look that never goes out of style—A-frames deliver.
      </p>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          A-Frame Benefits
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card p-8 hover-lift">
          <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">20-40% Lower Build Cost</h3>
          <p class="text-[var(--color-slate)] leading-relaxed">Simpler framing means less material and 30-50% less framing labour. The savings are real—not marketing spin.</p>
        </div>

        <div class="card p-8 hover-lift">
          <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">Built for Ontario Winters</h3>
          <p class="text-[var(--color-slate)] leading-relaxed">The steep 60-degree roof pitch sheds snow naturally. No raking, no worrying about snow load. Metal roofing makes it even better.</p>
        </div>

        <div class="card p-8 hover-lift">
          <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">Exceptional Natural Light</h3>
          <p class="text-[var(--color-slate)] leading-relaxed">The slanted roof leaves room for massive window walls on both ends. More light means lower energy costs and better mental health.</p>
        </div>

        <div class="card p-8 hover-lift">
          <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">Faster Construction</h3>
          <p class="text-[var(--color-slate)] leading-relaxed">Most A-frames go from foundation to move-in in 3-5 months. Traditional builds take 6-12 months. Less time paying for accommodations elsewhere.</p>
        </div>

        <div class="card p-8 hover-lift">
          <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">Timeless Design</h3>
          <p class="text-[var(--color-slate)] leading-relaxed">A-frames have been iconic since the 1950s and show no signs of going out of style. The dramatic interior spaces with soaring ceilings never get old.</p>
        </div>

        <div class="card p-8 hover-lift">
          <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">Works on Difficult Lots</h3>
          <p class="text-[var(--color-slate)] leading-relaxed">Sloped, rocky, or uneven terrain? A-frames handle challenging sites better than most designs. Simpler foundation requirements save money.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest Trade-Offs Section -->
  <section class="py-24 md:py-32 bg-[var(--color-cream)]">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          A-Frame Trade-Offs
        </h2>
        <p class="text-xl text-[var(--color-slate)] max-w-2xl mx-auto">
          We want you to build the right home for your needs. Here's what you should know before choosing an A-frame.
        </p>
      </div>

      <div class="space-y-6">
        <div class="bg-white p-6 md:p-8 border-l-4 border-[var(--color-stone)]">
          <h3 class="font-display text-xl text-[var(--color-charcoal)] mb-3">Limited Storage Space</h3>
          <p class="text-[var(--color-slate)]">There are no traditional walls on upper floors to mount closets against. Built-in storage helps, and we can design creative solutions during construction. But if you have a lot of stuff, you'll need to plan carefully.</p>
        </div>

        <div class="bg-white p-6 md:p-8 border-l-4 border-[var(--color-stone)]">
          <h3 class="font-display text-xl text-[var(--color-charcoal)] mb-3">Upper Floor Space is Limited</h3>
          <p class="text-[var(--color-slate)]">The angled walls reduce usable floor space on upper levels. A 1,200 sq ft footprint doesn't mean 1,200 sq ft of living space. Dormers and extensions can help, but that adds cost.</p>
        </div>

        <div class="bg-white p-6 md:p-8 border-l-4 border-[var(--color-stone)]">
          <h3 class="font-display text-xl text-[var(--color-charcoal)] mb-3">Furniture Layout Takes Planning</h3>
          <p class="text-[var(--color-slate)]">Tall bookshelves and standard dressers won't sit flush against A-frame walls. Platform beds and low furniture work well. Most clients find the dramatic ceilings worth the furniture constraints.</p>
        </div>

        <div class="bg-white p-6 md:p-8 border-l-4 border-[var(--color-stone)]">
          <h3 class="font-display text-xl text-[var(--color-charcoal)] mb-3">Roof Repairs are Harder</h3>
          <p class="text-[var(--color-slate)]">The roof IS the exterior—it takes the brunt of weather year-round. When repairs are needed, the steep pitch means scaffolding or specialized equipment. Not a frequent issue with quality materials, but something to know.</p>
        </div>

        <div class="bg-white p-6 md:p-8 border-l-4 border-[var(--color-stone)]">
          <h3 class="font-display text-xl text-[var(--color-charcoal)] mb-3">Heating and Cooling</h3>
          <p class="text-[var(--color-slate)]">Heat rises—upper lofts can get hot while ground floors stay cool. Ceiling fans, proper insulation, and HVAC design solve this, but it needs to be planned from the start. We build to R-40+ standards to minimize these issues.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Services -->
  <section class="py-24 md:py-32 bg-[var(--color-charcoal)] text-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-display mb-6">
            A-Frame Services
          </h2>

          <div class="space-y-8">
            <div class="flex gap-6">
              <div class="w-12 h-12 border border-[var(--color-timber)] flex items-center justify-center flex-shrink-0">
                <span class="text-[var(--color-timber)] font-display text-lg">01</span>
              </div>
              <div>
                <h3 class="text-xl font-display mb-2">Custom A-Frame Design</h3>
                <p class="text-white/70">Work with us from scratch or bring your plans. We help optimize for your lot, budget, and how you want to use the space. No cookie-cutter designs.</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="w-12 h-12 border border-[var(--color-timber)] flex items-center justify-center flex-shrink-0">
                <span class="text-[var(--color-timber)] font-display text-lg">02</span>
              </div>
              <div>
                <h3 class="text-xl font-display mb-2">Permits & Planning</h3>
                <p class="text-white/70">We handle building permits, site plans, septic approvals, and conservation authority requirements. Each municipality has different rules—we know what each one needs.</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="w-12 h-12 border border-[var(--color-timber)] flex items-center justify-center flex-shrink-0">
                <span class="text-[var(--color-timber)] font-display text-lg">03</span>
              </div>
              <div>
                <h3 class="text-xl font-display mb-2">Full Construction</h3>
                <p class="text-white/70">Foundation to finishing touches. We manage every trade and keep you informed every step of the way. Weekly photo updates. Phone calls returned the same day.</p>
              </div>
            </div>

            <div class="flex gap-6">
              <div class="w-12 h-12 border border-[var(--color-timber)] flex items-center justify-center flex-shrink-0">
                <span class="text-[var(--color-timber)] font-display text-lg">04</span>
              </div>
              <div>
                <h3 class="text-xl font-display mb-2">Shell or Turnkey—Your Choice</h3>
                <p class="text-white/70">Want to do some work yourself? We can build to lock-up stage and let you finish the interior. Or we handle everything. Either way, you get our 2-year warranty on our work.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="img-zoom">
            <img
              src="/images/projects/image00007.webp"
              srcset="/images/projects/image00007-800.webp 800w, /images/projects/image00007.webp 1920w"
              sizes="(min-width: 1024px) 50vw, 100vw"
              alt="A-frame cabin interior with exposed timber framing"
              class="w-full aspect-[4/5] object-cover"
              width="1920"
              height="1440"
              loading="lazy" decoding="async"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 bg-[var(--color-timber)] p-8 text-[var(--color-charcoal)]">
            <p class="text-4xl font-display mb-1">20+</p>
            <p class="text-sm font-medium">Years in<br />the Trades</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Build Process -->
  <section class="py-24 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          Our Build Process
        </h2>
        <p class="text-xl text-[var(--color-slate)] max-w-2xl mx-auto">
          Our promise: you'll always know what's happening with your build. Weekly updates. Phone calls returned the same day. No surprises.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 border-2 border-[var(--color-timber)] flex items-center justify-center">
            <span class="text-2xl font-display text-[var(--color-charcoal)]">01</span>
          </div>
          <h3 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Consultation</h3>
          <p class="text-[var(--color-slate)] text-sm leading-relaxed">We visit your lot, discuss your vision, and give honest feedback on what's possible within your budget.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 border-2 border-[var(--color-timber)] flex items-center justify-center">
            <span class="text-2xl font-display text-[var(--color-charcoal)]">02</span>
          </div>
          <h3 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Design & Quote</h3>
          <p class="text-[var(--color-slate)] text-sm leading-relaxed">Detailed plans, a fixed-price quote, and a signed contract. You'll know exactly what you're getting and what it costs.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 border-2 border-[var(--color-timber)] flex items-center justify-center">
            <span class="text-2xl font-display text-[var(--color-charcoal)]">03</span>
          </div>
          <h3 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Permits</h3>
          <p class="text-[var(--color-slate)] text-sm leading-relaxed">We handle the paperwork: building permits, site plans, and septic approvals.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 border-2 border-[var(--color-timber)] flex items-center justify-center">
            <span class="text-2xl font-display text-[var(--color-charcoal)]">04</span>
          </div>
          <h3 class="font-display text-lg text-[var(--color-charcoal)] mb-2">Construction</h3>
          <p class="text-[var(--color-slate)] text-sm leading-relaxed">Weekly updates with photos. We answer every call. You're never left wondering what's happening.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 border-2 border-[var(--color-timber)] flex items-center justify-center">
