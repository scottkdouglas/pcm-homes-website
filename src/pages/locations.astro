---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projectImg } from '../lib/project-images';

const serviceAreas = [
  {
    name: 'Muskoka Lakes',
    tagline: 'Premier Cottage Country',
    description: 'Custom cottages and year-round homes in Ontario\'s most sought-after destination. Waterfront builds, A-frames, and luxury retreats.',
    services: ['Custom cottages & A-frames', 'Year-round builds', 'Waterfront expertise'],
    image: '/images/projects/image00011.webp',
    link: '/locations/muskoka',
  },
  {
    name: 'Kawartha Lakes',
    tagline: 'Natural Beauty Meets Craft',
    description: 'Beautiful homes and cottages in the heart of the Kawarthas, where natural beauty meets quality craftsmanship.',
    services: ['Cottage construction', 'Custom home builds', 'Renovations & additions'],
    image: '/images/projects/image00009.webp',
    link: '/locations/kawartha-lakes',
  },
  {
    name: 'Durham Region',
    tagline: 'Residential Excellence',
    description: 'Comprehensive residential construction throughout Durham. From ICF foundations to complete custom homes.',
    services: ['Custom residential builds', 'ICF construction', 'Home additions'],
    image: '/images/projects/image00004.webp',
    link: '/locations/durham-region',
  },
  {
    name: 'York Region',
    tagline: 'Based in Stouffville',
    description: 'Custom homes, renovations, and additions across York Region. From Markham to Georgina, with strongest local presence around our Stouffville base.',
    services: ['Custom homes', 'Renovations & additions', 'Heritage & rural work'],
    image: '/images/projects/image00001.webp',
    link: '/locations/york-region',
  },
  {
    name: 'Greater Toronto Area',
    tagline: 'Outer GTA Focus',
    description: 'Custom builds, tear-down rebuilds, and major renovations across the outer GTA. Markham, Vaughan, Mississauga, Pickering, and the 905.',
    services: ['Custom builds & rebuilds', 'Major renovations', 'Additions'],
    image: '/images/projects/image00006.webp',
    link: '/locations/gta',
  },
];
---

<BaseLayout breadcrumbs={[{ name: "Service Areas", path: "/locations" }]} title="Service Areas: Durham, York, GTA, Kawartha, Muskoka" description="PCM Homes serves Muskoka Lakes, Kawartha Lakes, Durham Region, York Region, and the Greater Toronto Area (GTA).">
  <!-- Hero Section -->
  <section data-hero="dark" class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/image00011.webp"
        srcset="/images/projects/image00011-800.webp 800w, /images/projects/image00011.webp 1920w"
        sizes="100vw"
        alt="PCM Homes cottage build in Muskoka"
        class="w-full h-full object-cover"
        width="1920"
        height="1440"
        fetchpriority="high" decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center text-white pt-24">
      <p class="section-label text-white/80 mb-4">Where We Build</p>
      <h1 class="text-5xl md:text-7xl font-display font-medium mb-6">
        Our <span class="italic">Service Areas</span>
      </h1>
      <p class="text-xl text-white/80 max-w-2xl mx-auto">
        Durham, York, the GTA, Kawartha Lakes and Muskoka. Further afield when your project needs it.
      </p>
    </div>
  </section>

  <!-- Service Areas Grid -->
  <section class="py-24 md:py-32 bg-[var(--color-cream)]">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-20">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          From Cottage Country<br />
          to the City
        </h2>
      </div>

      <!-- Areas Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {serviceAreas.map((area, index) => {
          const CardWrapper = area.link ? 'a' : 'div';
          const cardProps = area.link ? { href: area.link } : {};
          return (
            <CardWrapper {...cardProps} class="group card overflow-hidden hover-lift block">
              <div class="relative h-56 overflow-hidden">
                <img
                  {...projectImg(area.image)}
                  sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                  alt={`PCM Homes project in ${area.name}`}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-4 left-4">
                  <span class="text-white/70 text-sm">{area.tagline}</span>
                </div>
              </div>
              <div class="p-8">
                <div class="flex items-center justify-between mb-3">
                  <h3 class="text-2xl font-display text-[var(--color-charcoal)]">{area.name}</h3>
                  {area.link && (
                    <svg class="w-5 h-5 text-[var(--color-timber)] group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                    </svg>
                  )}
                </div>
                <p class="text-[var(--color-slate)] mb-6 leading-relaxed">{area.description}</p>
                <ul class="space-y-3">
                  {area.services.map((service) => (
                    <li class="flex items-start gap-3">
                      <svg class="w-5 h-5 text-[var(--color-timber)] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span class="text-[var(--color-charcoal)]">{service}</span>
                    </li>
                  ))}
                </ul>
                {area.link && (
                  <p class="mt-6 text-[var(--color-timber-text)] font-medium text-sm uppercase tracking-wide">
                    View Full Guide →
                  </p>
                )}
              </div>
            </CardWrapper>
          );
        })}

        <!-- Cottage Country Card -->
        <div class="overflow-hidden bg-[var(--color-charcoal)] text-white hover-lift border border-[var(--color-charcoal)]">
          <div class="p-8 h-full flex flex-col">
            <div class="mb-6">
              <div class="w-16 h-16 border border-[var(--color-timber)] flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-[var(--color-timber)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <span class="text-[var(--color-timber)] text-sm mb-2 block">By Project</span>
              <h3 class="text-2xl font-display mb-3">Further Afield</h3>
            </div>
            <p class="text-white/70 mb-6 leading-relaxed flex-grow">
              Building just outside our five regions? Call us. We take projects further afield when the job is the right fit.
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-timber)] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/90">Seasonal & year-round</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-timber)] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/90">Flexible travel range</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-[var(--color-timber)] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-white/90">Call to check your location</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Coverage Details -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Content -->
        <div>
          <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
            How Far Do We Travel?
          </h2>

          <div class="prose-pcm space-y-6">
            <p>
              PCM Homes serves homeowners, designers, and architects across Durham, York, the GTA, Kawartha Lakes and Muskoka. Whether you're building a lakefront cottage in Muskoka or renovating a century home in the GTA, we bring the same commitment to quality and communication.
            </p>
            <p>
              <strong>The short answer?</strong> Those five regions first. We go further afield when your project needs it.
            </p>
          </div>

          <div class="mt-10 grid grid-cols-2 gap-6">
            <div class="bg-[var(--color-cream)] p-6">
              <p class="text-3xl font-display text-[var(--color-charcoal)] mb-2">2-3 Days</p>
              <p class="text-[var(--color-slate)] text-sm">Response time for small renovations</p>
            </div>
            <div class="bg-[var(--color-cream)] p-6">
              <p class="text-3xl font-display text-[var(--color-charcoal)] mb-2">1-2 Weeks</p>
              <p class="text-[var(--color-slate)] text-sm">Response time for custom builds</p>
            </div>
          </div>
        </div>

        <!-- Image Grid -->
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="img-zoom">
              <img
                src="/images/projects/image00003.webp"
                srcset="/images/projects/image00003-800.webp 800w, /images/projects/image00003.webp 1920w"
                sizes="(min-width: 1024px) 25vw, 50vw"
                alt="PCM Homes interior craftsmanship"
                class="w-full aspect-[3/4] object-cover"
                width="1920"
                height="2560"
                loading="lazy" decoding="async"
              />
            </div>
            <div class="img-zoom">
              <img
                src="/images/projects/image00008.webp"
                srcset="/images/projects/image00008-800.webp 800w, /images/projects/image00008.webp 1920w"
                sizes="(min-width: 1024px) 25vw, 50vw"
                alt="PCM Homes pool and outdoor living"
                class="w-full aspect-square object-cover"
                width="1920"
                height="2560"
                loading="lazy" decoding="async"
              />
            </div>
          </div>
          <div class="pt-8">
            <div class="img-zoom">
              <img
                src="/images/projects/image00002.webp"
                srcset="/images/projects/image00002-800.webp 800w, /images/projects/image00002.webp 1920w"
                sizes="(min-width: 1024px) 25vw, 50vw"
                alt="PCM Homes luxury interior"
                class="w-full aspect-[3/5] object-cover"
                width="1920"
                height="1440"
                loading="lazy" decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Summary -->
  <section class="py-24 md:py-32 bg-[var(--color-cream)]">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          Services by Region
        </h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b-2 border-[var(--color-charcoal)]">
              <th class="py-4 px-6 text-left font-display text-lg text-[var(--color-charcoal)]">Region</th>
              <th class="py-4 px-6 text-center font-display text-lg text-[var(--color-charcoal)]">Custom Homes</th>
              <th class="py-4 px-6 text-center font-display text-lg text-[var(--color-charcoal)]">Cottages</th>
              <th class="py-4 px-6 text-center font-display text-lg text-[var(--color-charcoal)]">ICF</th>
              <th class="py-4 px-6 text-center font-display text-lg text-[var(--color-charcoal)]">Renovations</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-stone)]/30">
            {[
              { region: 'Muskoka Lakes', homes: true, cottages: true, icf: true, renovations: true },
              { region: 'Kawartha Lakes', homes: true, cottages: true, icf: true, renovations: true },
              { region: 'Durham Region', homes: true, cottages: false, icf: true, renovations: true },
              { region: 'York Region', homes: true, cottages: false, icf: true, renovations: true },
              { region: 'GTA', homes: true, cottages: false, icf: true, renovations: true },
            ].map((row) => (
              <tr class="hover:bg-white/50 transition-colors">
                <td class="py-4 px-6 font-medium text-[var(--color-charcoal)]">{row.region}</td>
                <td class="py-4 px-6 text-center">
                  {row.homes ? (
                    <svg class="w-6 h-6 text-[var(--color-timber)] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  ) : (
                    <span class="text-[var(--color-stone)]">—</span>
                  )}
                </td>
                <td class="py-4 px-6 text-center">
                  {row.cottages ? (
                    <svg class="w-6 h-6 text-[var(--color-timber)] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  ) : (
                    <span class="text-[var(--color-stone)]">—</span>
                  )}
                </td>
                <td class="py-4 px-6 text-center">
                  {row.icf ? (
                    <svg class="w-6 h-6 text-[var(--color-timber)] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  ) : (
                    <span class="text-[var(--color-stone)]">—</span>
                  )}
                </td>
                <td class="py-4 px-6 text-center">
                  {row.renovations ? (
                    <svg class="w-6 h-6 text-[var(--color-timber)] mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  ) : (
                    <span class="text-[var(--color-stone)]">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section data-hero="dark" class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/image00007.webp"
        srcset="/images/projects/image00007-800.webp 800w, /images/projects/image00007.webp 1920w"
        sizes="100vw"
        alt="PCM Homes timber frame"
        class="w-full h-full object-cover"
        width="1920"
        height="1440"
        loading="lazy" decoding="async"
      />
      <div class="absolute inset-0 bg-black/70"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center text-white">
      <h2 class="text-4xl md:text-5xl font-display mb-8">
        Is Your Location<br />
        Covered?
      </h2>
      <p class="text-xl text-white/80 mb-12 max-w-2xl mx-auto leading-relaxed">
        Contact us to discuss your project location and receive a free consultation. We respond to all inquiries within 24 hours.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">
          <span>Discuss Your Project</span>
        </a>
        <a href="tel:+19057161939" class="btn-secondary-light">
          Call (905) 716-1939
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
