---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout breadcrumbs={[{ name: "About", path: "/about" }]} title="About Us" description="PCM Homes was founded in 2015 by Dan Edralin, who has 20+ years in the trades. Custom homes, cottages and renovations from Durham to Muskoka.">
  <!-- Hero Section -->
  <section data-hero="dark" class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/image00003.webp"
        srcset="/images/projects/image00003-800.webp 800w, /images/projects/image00003.webp 1920w"
        sizes="100vw"
        alt="PCM Homes craftsmanship"
        class="w-full h-full object-cover"
        width="1920"
        height="2560"
        fetchpriority="high" decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/50 to-black/70"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center text-white pt-24">
      <p class="section-label text-white/80 mb-4">Our Story</p>
      <h1 class="text-5xl md:text-7xl font-display font-medium mb-6">
        About <span class="italic">PCM Homes</span>
      </h1>
      <p class="text-xl text-white/80 max-w-2xl mx-auto">
        20+ years in the trades. Building quality homes with exceptional communication and craftsmanship since 2015.
      </p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="py-24 md:py-32 bg-[var(--color-cream)] grain-overlay">
    <div class="relative z-10 max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Content -->
        <div>
          <h2 class="text-4xl md:text-5xl font-display mb-8 text-[var(--color-charcoal)]">
            Built on Communication
          </h2>
          <div class="space-y-6 text-[var(--color-slate)] leading-relaxed">
            <p>
              Dan Edralin has spent over 20 years working in home improvement, from hardwood flooring installation and resurfacing to full-scale renovations. In 2015, he founded PCM Homes to bring that hands-on experience to custom home building. The company grew from a simple belief: homeowners deserve to know what's happening with their biggest investment.
            </p>
            <p>
              What sets us apart? We actually talk to you. While other contractors leave clients wondering about their project status, we provide regular updates, listen to concerns, and solve problems together. It's not complicated, but it makes all the difference.
            </p>
            <p>
              From cottage country to the Greater Toronto Area, we bring the same dedication, expertise, and attention to detail to every project we undertake.
            </p>
          </div>
        </div>

        <!-- Image -->
        <div class="relative">
          <div class="img-zoom">
            <img
              src="/images/projects/image00002.webp"
              srcset="/images/projects/image00002-800.webp 800w, /images/projects/image00002.webp 1920w"
              sizes="(min-width: 1024px) 50vw, 100vw"
              alt="Luxury interior detail"
              class="w-full aspect-[4/5] object-cover"
              width="1920"
              height="1440"
              loading="lazy" decoding="async"
            />
          </div>
          <div class="absolute -bottom-8 -left-8 bg-white p-8 shadow-xl">
            <div class="flex items-baseline gap-2 mb-2">
              <span class="text-5xl font-display font-medium text-[var(--color-charcoal)]">2015</span>
            </div>
            <p class="text-[var(--color-stone)] text-sm">When our journey<br />began</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-24 md:py-32 bg-white">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          Why Customers Choose Us
        </h2>
      </div>

      <!-- Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Communication -->
        <div class="card p-10 hover-lift">
          <h3 class="text-2xl font-display text-[var(--color-charcoal)] mb-4">Superior Communication</h3>
          <p class="text-[var(--color-slate)] leading-relaxed mb-4">
            Clear, consistent communication is our #1 strength. We provide regular updates via email, calls, and text with photos throughout your project.
          </p>
          <p class="text-[var(--color-stone)] italic text-sm">
            "What customers complain about with other contractors: poor communication and inflexibility. That's exactly where we excel."
          </p>
        </div>

        <!-- Problem Solving -->
        <div class="card p-10 hover-lift">
          <h3 class="text-2xl font-display text-[var(--color-charcoal)] mb-4">Flexibility & Problem Solving</h3>
          <p class="text-[var(--color-slate)] leading-relaxed mb-4">
            We don't just build to plans - we partner with you to solve problems and achieve the best results. Every project presents unique challenges.
          </p>
          <p class="text-[var(--color-stone)] text-sm">
            Our experience allows us to navigate challenges efficiently and adapt when needed.
          </p>
        </div>

        <!-- In-House -->
        <div class="card p-10 hover-lift">
          <h3 class="text-2xl font-display text-[var(--color-charcoal)] mb-4">Full In-House Capabilities</h3>
          <p class="text-[var(--color-slate)] leading-relaxed mb-4">
            Our crew handles both concrete structure (ICF) and wood structure in-house. This allows us to control quality and timelines better than contractors who subcontract everything.
          </p>
          <p class="text-[var(--color-stone)] text-sm">
            We work with trusted sub-contractors who have been in business for years.
          </p>
        </div>

        <!-- Owner-Led -->
        <div class="card p-10 hover-lift">
          <h3 class="text-2xl font-display text-[var(--color-charcoal)] mb-4">Owner-Led Attention to Detail</h3>
          <p class="text-[var(--color-slate)] leading-relaxed mb-4">
            Dan's background spans from structure to finish details, allowing close attention to the craftsmanship that homeowners appreciate most.
          </p>
          <p class="text-[var(--color-stone)] text-sm">
            From foundation to final finishes, nothing falls through the cracks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-24 md:py-32 bg-[var(--color-charcoal)]">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Content -->
        <div>
          <h2 class="text-4xl md:text-5xl font-display text-white mb-8">
            Meet Dan Edralin
          </h2>
          <p class="text-white/80 text-lg leading-relaxed mb-6">
            With over 20 years in the trades, including renovations, hardwood flooring and finish carpentry, Dan built PCM Homes on the skills he spent two decades sharpening. He personally oversees each project, ensuring quality from design through completion.
          </p>

          <div class="grid grid-cols-2 gap-8 mb-8">
            <div>
              <h4 class="text-white font-medium mb-3">Core Team</h4>
              <ul class="space-y-2 text-white/60">
                <li class="flex items-center gap-2">
                  <div class="w-1 h-1 bg-[var(--color-timber)]"></div>
                  2 Owners
                </li>
                <li class="flex items-center gap-2">
                  <div class="w-1 h-1 bg-[var(--color-timber)]"></div>
                  4 Skilled Carpenters
                </li>
                <li class="flex items-center gap-2">
                  <div class="w-1 h-1 bg-[var(--color-timber)]"></div>
                  Trusted Sub-contractors
                </li>
              </ul>
            </div>
            <div>
              <h4 class="text-white font-medium mb-3">Availability</h4>
              <ul class="space-y-2 text-white/60">
                <li class="flex items-center gap-2">
                  <div class="w-1 h-1 bg-[var(--color-timber)]"></div>
                  Mon-Fri, 8am - 6pm
                </li>
                <li class="flex items-center gap-2">
                  <div class="w-1 h-1 bg-[var(--color-timber)]"></div>
                  Direct Owner Access
                </li>
                <li class="flex items-center gap-2">
                  <div class="w-1 h-1 bg-[var(--color-timber)]"></div>
                  Call, Text, or Email
                </li>
              </ul>
            </div>
          </div>

          <p class="text-white/60 text-sm">
            When you call PCM Homes, you'll speak directly with Dan or Anita, ensuring quick responses and clear communication at every stage.
          </p>
        </div>

        <!-- Image Grid -->
        <div class="grid grid-cols-2 gap-4">
          <div class="img-zoom">
            <img src="/images/projects/image00006.webp" srcset="/images/projects/image00006-800.webp 800w, /images/projects/image00006.webp 1920w" sizes="(min-width: 1024px) 25vw, 50vw" alt="Quality craftsmanship" class="w-full aspect-square object-cover" width="1920" height="1440" loading="lazy" decoding="async" />
          </div>
          <div class="img-zoom mt-12">
            <img src="/images/projects/image00008.webp" srcset="/images/projects/image00008-800.webp 800w, /images/projects/image00008.webp 1920w" sizes="(min-width: 1024px) 25vw, 50vw" alt="Attention to detail" class="w-full aspect-square object-cover" width="1920" height="2560" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials Section -->
  <section class="py-24 md:py-20 bg-[var(--color-cream)] grain-overlay">
    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          Credentials & Guarantees
        </h2>
      </div>

      <!-- Credentials Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {[
          { icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z', title: 'Fully Insured', desc: 'Complete coverage' },
          { icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', title: 'Permits Handled', desc: 'We apply for them' },
          { icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z', title: '2-Year Warranty', desc: 'Workmanship guarantee' },
          { icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z', title: '20+ Years', desc: "Dan's trade experience" },
        ].map((item) => (
          <div class="text-center">
            <h3 class="font-display text-lg text-[var(--color-charcoal)] mb-1">{item.title}</h3>
            <p class="text-[var(--color-stone)] text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who We Work With -->
  <section class="py-24 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <!-- Section Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-display text-[var(--color-charcoal)] mb-6">
          Who We Work With
        </h2>
      </div>

      <!-- Client Types -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {[
          { title: 'Homeowners', desc: 'Building dream homes and transforming existing spaces', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
          { title: 'Designers', desc: 'Bringing creative visions to life with precision', icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01' },
          { title: 'Architects', desc: 'Executing detailed plans with expert craftsmanship', icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10' },
        ].map((client) => (
          <div class="text-center p-8">
            <h3 class="text-xl font-display text-[var(--color-charcoal)] mb-3">{client.title}</h3>
            <p class="text-[var(--color-slate)]">{client.desc}</p>
          </div>
        ))}
      </div>

      <!-- How People Find Us -->
      <div class="bg-[var(--color-timber-light)]/30 p-8 md:p-12 text-center">
        <p class="text-lg text-[var(--color-charcoal)]">
          <strong>How people find us:</strong> Most of our clients come through referrals, Instagram, and industry suppliers - a testament to our reputation for quality work and client satisfaction.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/projects/image00001.webp"
        srcset="/images/projects/image00001-800.webp 800w, /images/projects/image00001.webp 1920w"
        sizes="100vw"
        alt="Luxury living space"
        class="w-full h-full object-cover"
        width="1920"
        height="1440"
        loading="lazy" decoding="async"
      />
      <div class="absolute inset-0 bg-[var(--color-charcoal)]/80"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 text-center text-white">
      <h2 class="text-4xl md:text-6xl font-display mb-8">
        Ready to Work<br />
        Together?
      </h2>
      <p class="text-xl text-white/70 mb-12 max-w-2xl mx-auto leading-relaxed">
        Experience the PCM Homes difference - exceptional communication, quality craftsmanship, and attention to detail.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">
          <span>Get Started</span>
        </a>
        <a href="tel:+19057161939" class="btn-secondary-light">
          Call (905) 716-1939
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
